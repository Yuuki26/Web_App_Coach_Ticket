DB_USER=root
DB_PASSWORD=change-me
# 32+ random characters, e.g. from: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
APP_PUBLIC_URL=http://localhost:8081
