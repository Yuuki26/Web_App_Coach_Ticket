# Copy to .env (never commit .env) or set these in your shell / hosting platform.
DB_URL=jdbc:mysql://localhost:3306/hcoach?createDatabaseIfNotExist=true
DB_USER=root
DB_PASSWORD=change-me
# 32+ random characters, e.g. from: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
APP_PUBLIC_URL=http://localhost:8081
# Live traffic. Copy this file to .env and put your key there: the app reads .env on start, and git ignores it.
TOMTOM_API_KEY=
# Or a Google Maps key with the Routes API enabled (used instead of TomTom when both are set)
GOOGLE_MAPS_API_KEY=
# auto (whichever key is set) | tomtom | google | simulated (made-up numbers for development) | off
TRAFFIC_PROVIDER=auto
